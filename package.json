{
  "name": "math-physics-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && vite build --config vite.cli.config.ts",
    "build:cli": "vite build --config vite.cli.config.ts",
    "cli": "node bin/math-physics-workbench.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && TARGET=web vite build",
    "serve:web": "TARGET=web vite preview --outDir dist-web --host",
    "build:ios": "npm run build:web && cap sync ios",
    "open:ios": "cap open ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:handwriting": "node scripts/setup-handwriting.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@huggingface/transformers": "^3.8.1",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^13.0.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "katex": "^0.19.1",
    "mathjs": "^15.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "productName": "Math & Physics Workbench",
  "description": "Open-source desktop app for learning and doing math and physics: graph functions, simulate differential equations, run numerical experiments, and fit models to data.",
  "author": "Pifer Labs LLC",
  "main": "electron/main.cjs",
  "bin": {
    "math-physics-workbench": "bin/math-physics-workbench.mjs"
  },
  "build": {
    "appId": "io.mathphysicsworkbench.app",
    "productName": "Math & Physics Workbench",
    "artifactName": "math-physics-workbench-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "physsim",
        "name": "Physics Simulation",
        "description": "Math & Physics Workbench simulation",
        "role": "Editor"
      },
      {
        "ext": "physflow",
        "name": "Physics Flow",
        "description": "Math & Physics Workbench equation flow",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Education;Science",
      "executableName": "math-physics-workbench",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Pifer Labs LLC"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "copyright": "Copyright (C) 2026 Pifer Labs LLC"
  },
  "license": "AGPL-3.0-or-later"
}
